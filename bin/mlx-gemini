#!/usr/bin/env bash
# Run Gemini CLI with a local MLX model via engrave protocol translation.
# Usage: mlx-gemini <model|index> [-- gemini-args...]
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
[[ $# -lt 1 ]] && { echo "Usage: mlx-gemini <model|index> [-- gemini-args...]"; echo "Run 'mlx-models' to see available models."; exit 1; }
MODEL="$1"; shift
exec "$SCRIPT_DIR/mlx-run" --runner gemini --model "$MODEL" -- "$@"
