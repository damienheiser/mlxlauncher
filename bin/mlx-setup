#!/usr/bin/env bash
# Install/upgrade mlx-lm in the dedicated venv
set -euo pipefail

VENV="${HOME}/.lmstudio/venv"

if [[ ! -d "$VENV" ]]; then
    echo "Creating venv at $VENV ..."
    python3 -m venv "$VENV"
fi

echo "Installing/upgrading mlx-lm..."
"$VENV/bin/pip" install -U mlx-lm

echo ""
echo "Done. You can now run:"
echo "  mlx-models   — list available local models"
echo "  mlx-serve    — launch a model as an OpenAI-compatible API"
