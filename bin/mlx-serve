#!/usr/bin/env bash
# Launch an MLX model as an OpenAI-compatible API server with tuned parameters.
# Usage:
#   mlx-serve <org/model>                 — by name
#   mlx-serve <number>                    — by index from mlx-models
#   mlx-serve <org/model> --port 8080     — custom port
#   mlx-serve <org/model> --think         — enable thinking mode
set -euo pipefail

MODELS_DIR="${HOME}/.lmstudio/models"
VENV="${HOME}/.lmstudio/venv"
CONFIG_FILE="${HOME}/.lmstudio/model-configs.json"
PORT=1234
THINK_MODE=false

is_chat_model() {
    local dir="$1"
    ls "$dir"/*.gguf &>/dev/null && return 1
    ls "$dir"/*.safetensors &>/dev/null || ls "$dir"/model-*.safetensors &>/dev/null || return 1
    local config="$dir/config.json"
    if [[ -f "$config" ]]; then
        local model_type
        model_type=$(python3 -c "import json; print(json.load(open('$config')).get('model_type',''))" 2>/dev/null || echo "")
        case "$model_type" in
            gemma4*|gemma3*|gemma2*|glm4*) return 0 ;;
        esac
    fi
    local index="$dir/model.safetensors.index.json"
    if [[ -f "$index" ]]; then
        grep -q "lm_head" "$index" || return 1
    fi
    return 0
}

usage() {
    echo "Usage: mlx-serve <model> [--port PORT] [--think]"
    echo ""
    echo "  model   — org/model name or index number from 'mlx-models'"
    echo "  --port  — port to serve on (default: 1234)"
    echo "  --think — enable thinking/reasoning mode"
    echo ""
    echo "Run 'mlx-models' to see available models."
    exit 1
}

[[ $# -lt 1 ]] && usage

MODEL_ARG="$1"
shift

# Parse remaining flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        --port)  PORT="$2"; shift 2 ;;
        --think) THINK_MODE=true; shift ;;
        *)       echo "Unknown option: $1"; usage ;;
    esac
done

# If argument is a number, resolve it from the model list (same filter as mlx-models)
if [[ "$MODEL_ARG" =~ ^[0-9]+$ ]]; then
    i=1
    MODEL_PATH=""
    while IFS= read -r dir; do
        if is_chat_model "$dir"; then
            if [[ $i -eq $MODEL_ARG ]]; then
                MODEL_PATH="$dir"
                break
            fi
            i=$((i + 1))
        fi
    done < <(find "$MODELS_DIR" -mindepth 2 -maxdepth 2 -type d | sort)

    if [[ -z "$MODEL_PATH" ]]; then
        echo "Error: No model at index $MODEL_ARG. Run 'mlx-models' to see available models."
        exit 1
    fi
else
    MODEL_PATH="${MODELS_DIR}/${MODEL_ARG}"
fi

if [[ ! -d "$MODEL_PATH" ]]; then
    echo "Error: Model not found at $MODEL_PATH"
    echo "Run 'mlx-models' to see available models."
    exit 1
fi

# Validate it's a servable chat model
if ! is_chat_model "$MODEL_PATH"; then
    MODEL_NAME=$(basename "$MODEL_PATH")
    if ls "$MODEL_PATH"/*.gguf &>/dev/null; then
        echo "Error: $MODEL_NAME is a GGUF model. Use llama.cpp or LM Studio for GGUF."
    else
        echo "Error: $MODEL_NAME is an embedding model (no lm_head). It can't generate text."
    fi
    exit 1
fi

if [[ ! -d "$VENV" ]]; then
    echo "Error: venv not found. Run 'mlx-setup' first."
    exit 1
fi

MODEL_NAME=$(echo "$MODEL_PATH" | sed "s|${MODELS_DIR}/||")

# --- Resolve generation parameters from config ---
# Uses a Python helper to merge: architecture defaults < model overrides
EXTRA_ARGS=()
if [[ -f "$CONFIG_FILE" ]]; then
    RESOLVED=$("$VENV/bin/python3" -c "
import json, sys

config = json.load(open('$CONFIG_FILE'))
model_name = '$MODEL_NAME'
think = $( [[ "$THINK_MODE" == true ]] && echo True || echo False )

# Detect architecture from model config.json
arch = '_default'
try:
    mc = json.load(open('$MODEL_PATH/config.json'))
    arch = mc.get('model_type', '_default')
except:
    pass

archs = config.get('architectures', {})
base = dict(archs.get('_default', {}))
arch_cfg = archs.get(arch, {})
model_cfg = config.get('models', {}).get(model_name, {})

# Merge: default < architecture < model-specific
for k, v in arch_cfg.items():
    if not k.startswith('_'):
        base[k] = v
for k, v in model_cfg.items():
    if not k.startswith('_'):
        base[k] = v

# Override thinking mode if requested
if think and 'chat_template_args' in base:
    base['chat_template_args'] = json.dumps({'enable_thinking': True})

args = []
for k, v in base.items():
    if k == 'use_default_chat_template' and v:
        args.append('--use-default-chat-template')
    elif k == 'chat_template_args':
        args.append(f'--chat-template-args')
        args.append(str(v))
    elif k in ('temp', 'top_p', 'top_k', 'min_p', 'max_tokens'):
        args.append(f'--{k.replace(\"_\", \"-\")}')
        args.append(str(v))

print(' '.join(args))
" 2>/dev/null || echo "")

    if [[ -n "$RESOLVED" ]]; then
        read -ra EXTRA_ARGS <<< "$RESOLVED"
    fi
fi

# Display config
echo "┌─────────────────────────────────────────────"
echo "│ Model:  $MODEL_NAME"
echo "│ Port:   $PORT"
echo "│ URL:    http://localhost:${PORT}/v1"
if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
    echo "│ Params: ${EXTRA_ARGS[*]}"
fi
if [[ "$THINK_MODE" == true ]]; then
    echo "│ Mode:   thinking enabled"
fi
echo "├─────────────────────────────────────────────"
echo "│ Compatible with:"
echo "│   mlx-codex $MODEL_NAME"
echo "│   curl http://localhost:${PORT}/v1/chat/completions"
echo "│"
echo "│ Press Ctrl+C to stop."
echo "└─────────────────────────────────────────────"

exec "$VENV/bin/python3" -m mlx_lm server \
    --model "$MODEL_PATH" \
    --port "$PORT" \
    "${EXTRA_ARGS[@]}"
