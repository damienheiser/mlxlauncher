#!/usr/bin/env bash
# Run Aider with a local MLX model (direct OpenAI-compatible connection).
# Usage: mlx-aider <model|index> [-- aider-args...]
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
[[ $# -lt 1 ]] && { echo "Usage: mlx-aider <model|index> [-- aider-args...]"; echo "Run 'mlx-models' to see available models."; exit 1; }
MODEL="$1"; shift
exec "$SCRIPT_DIR/mlx-run" --runner aider --model "$MODEL" -- "$@"
